<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="LocalDrop_Windows.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#080E1D" RequestedTheme="Dark">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="#0D1730">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="20,0,140,0">
                <Image Source="/Assets/BrandLogo.png" Width="86" Height="43" Stretch="Uniform" />
                <TextBlock x:Name="TaglineText" Text="Direct transfer" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#0D1730" Padding="16,26,16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WorkspaceText" Text="WORKSPACE" Margin="12,0,0,12" FontSize="11" FontWeight="SemiBold" Opacity="0.5" />
                        <Button x:Name="NearbyNavButton" Content="Nearby devices" Click="NearbyNav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,11" />
                        <Button x:Name="FilesNavButton" Content="Received files" Click="FilesNav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,11" />
                        <Button x:Name="SettingsNavButton" Content="Settings" Click="SettingsNav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,11" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="#172546" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="LocalNetworkText" Text="LOCAL NETWORK" FontSize="10" FontWeight="SemiBold" Opacity="0.6" />
                            <TextBlock x:Name="SidebarDeviceName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EncryptedText" Text="Encrypted device transfer" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Padding="32,28,32,24">
                <Grid x:Name="NearbyPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="NearbyTitle" Text="Nearby devices" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="OwnDeviceText" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#142541" CornerRadius="12" Padding="14,10" Margin="0,22,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatusText" Text="Starting discovery…" TextWrapping="Wrap" />
                            <TextBlock x:Name="TransferStatusText" Foreground="#75D9F6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ChooseDeviceText" Grid.Row="2" Text="Choose a device, then select a file to send" Margin="0,22,0,10" FontSize="13" Opacity="0.6" />
                    <ListView Grid.Row="3" x:Name="PeerList" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#152540" CornerRadius="14" Padding="18,14" Margin="0,0,0,8">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Opacity="0.65" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                        <Button x:Name="SendButton" Content="Select file and send" Click="SendFile_Click" Padding="18,10" Background="#1865E7" />
                        <Button x:Name="CancelButton" Content="Cancel transfer" Click="Cancel_Click" Padding="18,10" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="FilesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FilesTitle" Text="Received files" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="FilesSubtitle" Text="Files saved to Downloads / LocalDrop" Opacity="0.65" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,22,0,12">
                        <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshFiles_Click" />
                        <Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenDownloads_Click" />
                    </StackPanel>
                    <ListView Grid.Row="2" x:Name="ReceivedFileList" Background="Transparent" BorderThickness="0" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#152540" CornerRadius="14" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding OpenLabel}" Tag="{Binding Path}" Click="OpenFile_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" x:Name="FilesEmptyText" Text="No received files yet." Opacity="0.6" Margin="0,12,0,0" />
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                  <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceNameLabel" Text="Device name" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBox x:Name="DeviceNameBox" PlaceholderText="Name shown to nearby devices" MaxLength="64" />
                    <TextBlock x:Name="DeviceNameHelp" Text="Other devices see this name during discovery and verification. Your secure device identity stays the same." Opacity="0.65" TextWrapping="Wrap" />
                    <Button x:Name="SaveNameButton" Content="Save device name" Click="SaveName_Click" HorizontalAlignment="Left" Background="#1865E7" />
                    <TextBlock x:Name="SettingsStatusText" Foreground="#75D9F6" TextWrapping="Wrap" />
                    <TextBlock x:Name="LanguageLabel" Text="Language" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageBox_SelectionChanged" HorizontalAlignment="Left" MinWidth="180" />
                    <Border Background="#152540" CornerRadius="14" Padding="18" Margin="0,18,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="DownloadsTitle" Text="Downloads" FontWeight="SemiBold" />
                            <TextBlock x:Name="DownloadsHelp" Text="Received files are stored in your Downloads / LocalDrop folder." Opacity="0.65" TextWrapping="Wrap" />
                            <Button x:Name="OpenDownloadsButton" Content="Open downloads folder" Click="OpenDownloads_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="LocalDrop 0.1.0  ·  LD/1" Margin="0,18,0,0" Opacity="0.5" />
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid x:Name="PromptOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D0000715">
            <Border Background="#172844" CornerRadius="18" Padding="28" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="PromptTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PromptMessage" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock x:Name="PromptCode" FontSize="28" FontWeight="SemiBold" CharacterSpacing="180" Foreground="#75D9F6" Visibility="Collapsed" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="PromptDeclineButton" Content="Decline" Click="PromptDecline_Click" MinWidth="95" />
                        <Button x:Name="PromptAcceptButton" Content="Accept" Click="PromptAccept_Click" MinWidth="110" Background="#1865E7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
